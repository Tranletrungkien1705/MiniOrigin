@model List<Cte>
@{ ViewData["Title"] = "Loại sự kiện (CTE)"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">CTE (Critical Tracking Event) = loại sự kiện truy xuất; mỗi CTE có bộ trường dữ liệu KDE (Key Data Element).</p>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên sự kiện</th><th class="text-center">Số trường KDE</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr style="cursor:pointer" onclick="location.href='/Cte/Detail/@c.Id'">
                    <td class="fw-semibold small">@c.Code</td><td><i class="bi @c.Icon me-1"></i>@c.Name</td><td class="text-center">@c.Kdes.Count</td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Chưa có CTE.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm loại sự kiện</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên (VD Đóng gói) *" required /></div>
            <div class="mb-2"><input name="code" class="form-control text-uppercase" placeholder="Mã (tự sinh)" /></div>
            <div class="mb-3"><input name="icon" class="form-control" placeholder="Icon bootstrap (bi-box-seam)" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
