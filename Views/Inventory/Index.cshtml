@model List<InventoryView>
@{
    ViewData["Title"] = "Kho hàng";
    var q = (string?)ViewBag.Q;
    var active = (bool?)ViewBag.Active;
    var types = (List<InventoryTypeView>)ViewBag.Types;
    var levelTypes = (List<InventoryLevelTypeView>)ViewBag.LevelTypes;
    var inventories = (List<InventoryView>)ViewBag.Inventories;
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">Kho hàng (master) — điểm lưu trữ hàng hoá, có phân cấp cha–con. Mã kho duy nhất theo đơn vị; kho cấp trên, loại kho &amp; cấp kho phải tồn tại &amp; đang hoạt động. Port từ Mst_Inventory của InBrand.</p>
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6"><input name="q" value="@q" class="form-control form-control-sm" placeholder="Tìm mã / tên kho" /></div>
            <div class="col-sm-3"><select name="active" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="true" selected="@(active == true)">Đang hoạt động</option>
                <option value="false" selected="@(active == false)">Ngừng</option>
            </select></div>
            <div class="col-sm-3"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Lọc</button></div>
        </form>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên kho</th><th>Cấp trên</th><th>Loại</th><th>Cấp kho</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td class="fw-semibold small"><code>@v.Inventory.Code</code></td>
                    <td>@v.Inventory.Name @if (v.ChildCount > 0) { <span class="badge bg-light text-dark border ms-1">@v.ChildCount cấp dưới</span> }</td>
                    <td class="small text-muted">@(v.ParentName ?? "—")</td>
                    <td>@if (v.TypeName != null) { <span class="badge bg-light text-dark border">@v.TypeName</span> } else { <span class="text-muted">—</span> }</td>
                    <td>@if (v.LevelTypeName != null) { <span class="badge bg-light text-dark border">@v.LevelTypeName</span> } else { <span class="text-muted">—</span> }</td>
                    <td>@if (v.Inventory.Active) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                    <td class="text-end">
                        <form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Inventory.Id" />
                            <input type="hidden" name="active" value="@((!v.Inventory.Active).ToString().ToLower())" />
                            <button class="btn btn-sm btn-outline-secondary" title="@(v.Inventory.Active ? "Ngừng" : "Kích hoạt")"><i class="bi @(v.Inventory.Active ? "bi-pause-circle" : "bi-play-circle")"></i></button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xoá kho @v.Inventory.Code?');">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Inventory.Id" />
                            <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có kho.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Thêm kho</h6>
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="code" class="form-control text-uppercase" placeholder="Mã kho (VD KHO001) *" required /></div>
                <div class="mb-2"><input name="name" class="form-control" placeholder="Tên kho *" required /></div>
                <div class="mb-2"><select name="parentId" class="form-select" required>
                    <option value="">— Chọn kho cấp trên * —</option>
                    @foreach (var i in inventories) { <option value="@i.Inventory.Id">@i.Inventory.Code — @i.Inventory.Name</option> }
                </select></div>
                <div class="mb-2"><select name="typeId" class="form-select" required>
                    <option value="">— Chọn loại kho * —</option>
                    @foreach (var t in types) { <option value="@t.Type.Id">@t.Type.Code — @t.Type.Name</option> }
                </select></div>
                <div class="mb-2"><select name="levelTypeId" class="form-select" required>
                    <option value="">— Chọn cấp kho * —</option>
                    @foreach (var t in levelTypes) { <option value="@t.LevelType.Id">@t.LevelType.Code — @t.LevelType.Name</option> }
                </select></div>
                <div class="mb-2"><input name="address" class="form-control" placeholder="Địa chỉ (tùy chọn)" /></div>
                <div class="mb-2"><input name="contactName" class="form-control" placeholder="Người liên hệ (tùy chọn)" /></div>
                <div class="mb-2"><input name="contactPhone" class="form-control" placeholder="Điện thoại (tùy chọn)" /></div>
                <div class="mb-2"><input name="contactEmail" class="form-control" placeholder="Email (tùy chọn)" /></div>
                <div class="mb-2"><input name="remark" class="form-control" placeholder="Ghi chú (tùy chọn)" /></div>
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="active" value="true" id="invActive" checked /><label class="form-check-label" for="invActive">Đang hoạt động</label></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
            </form>
            <div class="small text-muted mt-3">Khi tạo: <code>InvBUCode/InvBUPattern="X"</code>, <code>InvLevel=1</code> (theo MstInventoryManager.Add).</div>
        </div></div>
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Loại kho</h6>
            <table class="table table-sm align-middle mb-2">
                <tbody>
                @foreach (var t in types)
                {
                    <tr>
                        <td class="small"><code>@t.Type.Code</code></td>
                        <td class="small">@t.Type.Name</td>
                        <td class="small text-muted">@t.InventoryCount</td>
                        <td class="text-end">
                            <form asp-action="DeleteType" method="post" class="d-inline" onsubmit="return confirm('Xoá loại @t.Type.Code?');">@Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Type.Id" />
                                <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (types.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">Chưa có loại kho.</td></tr> }
                </tbody>
            </table>
            <form asp-action="CreateType" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-5"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã loại *" required /></div>
                <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="Tên loại *" required /></div>
                <div class="col-2"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus-lg"></i></button></div>
            </form>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Cấp kho</h6>
            <table class="table table-sm align-middle mb-2">
                <tbody>
                @foreach (var t in levelTypes)
                {
                    <tr>
                        <td class="small"><code>@t.LevelType.Code</code></td>
                        <td class="small">@t.LevelType.Name</td>
                        <td class="small text-muted">@t.InventoryCount</td>
                        <td class="text-end">
                            <form asp-action="DeleteLevelType" method="post" class="d-inline" onsubmit="return confirm('Xoá cấp @t.LevelType.Code?');">@Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.LevelType.Id" />
                                <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (levelTypes.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">Chưa có cấp kho.</td></tr> }
                </tbody>
            </table>
            <form asp-action="CreateLevelType" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-5"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã cấp *" required /></div>
                <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="Tên cấp *" required /></div>
                <div class="col-2"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus-lg"></i></button></div>
            </form>
        </div></div>
    </div>
</div>
