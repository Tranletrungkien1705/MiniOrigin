@model List<DealerView>
@{
    ViewData["Title"] = "Đại lý";
    var q = (string?)ViewBag.Q;
    var active = (bool?)ViewBag.Active;
    var types = (List<DealerTypeView>)ViewBag.Types;
    var dealers = (List<DealerView>)ViewBag.Dealers;
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">Đại lý (master) — điểm bán/xác thực sản phẩm chính hãng, có phân cấp cha–con. Mã đại lý duy nhất theo đơn vị; đại lý cấp trên phải tồn tại &amp; đang hoạt động. Port từ Mst_Dealer của InBrand.</p>
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6"><input name="q" value="@q" class="form-control form-control-sm" placeholder="Tìm mã / tên đại lý" /></div>
            <div class="col-sm-3"><select name="active" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="true" selected="@(active == true)">Đang hoạt động</option>
                <option value="false" selected="@(active == false)">Ngừng</option>
            </select></div>
            <div class="col-sm-3"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Lọc</button></div>
        </form>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên đại lý</th><th>Cấp trên</th><th>Loại</th><th>Site</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td class="fw-semibold small"><code>@v.Dealer.Code</code></td>
                    <td>@v.Dealer.Name @if (v.ChildCount > 0) { <span class="badge bg-light text-dark border ms-1">@v.ChildCount cấp dưới</span> }</td>
                    <td class="small text-muted">@(v.ParentName ?? "—")</td>
                    <td>@if (v.DealerTypeName != null) { <span class="badge bg-light text-dark border">@v.DealerTypeName</span> } else { <span class="text-muted">—</span> }</td>
                    <td class="small text-muted">@(v.Dealer.SkycicSiteID ?? "—")</td>
                    <td>@if (v.Dealer.Active) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                    <td class="text-end">
                        <form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Dealer.Id" />
                            <input type="hidden" name="active" value="@((!v.Dealer.Active).ToString().ToLower())" />
                            <button class="btn btn-sm btn-outline-secondary" title="@(v.Dealer.Active ? "Ngừng" : "Kích hoạt")"><i class="bi @(v.Dealer.Active ? "bi-pause-circle" : "bi-play-circle")"></i></button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xoá đại lý @v.Dealer.Code?');">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Dealer.Id" />
                            <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đại lý.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Thêm đại lý</h6>
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="code" class="form-control text-uppercase" placeholder="Mã đại lý (VD DL001) *" required /></div>
                <div class="mb-2"><input name="name" class="form-control" placeholder="Tên đại lý *" required /></div>
                <div class="mb-2"><select name="parentId" class="form-select">
                    <option value="">— Không có cấp trên —</option>
                    @foreach (var d in dealers) { <option value="@d.Dealer.Id">@d.Dealer.Code — @d.Dealer.Name</option> }
                </select></div>
                <div class="mb-2"><select name="dealerTypeId" class="form-select">
                    <option value="">— Chưa phân loại —</option>
                    @foreach (var t in types) { <option value="@t.Type.Id">@t.Type.Code — @t.Type.Name</option> }
                </select></div>
                <div class="mb-2"><input name="skycicSiteId" class="form-control" placeholder="Mã site Skycic (tùy chọn)" /></div>
                <div class="mb-2"><input name="remark" class="form-control" placeholder="Ghi chú (tùy chọn)" /></div>
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="active" value="true" id="dlActive" checked /><label class="form-check-label" for="dlActive">Đang hoạt động</label></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
            </form>
            <div class="small text-muted mt-3">Khi tạo: <code>FlagRoot=No</code>, <code>DLBUCode/DLBUPattern="X"</code>, <code>DLLevel=1</code> (theo MstDealerAddX).</div>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Loại đại lý</h6>
            <table class="table table-sm align-middle mb-2">
                <tbody>
                @foreach (var t in types)
                {
                    <tr>
                        <td class="small"><code>@t.Type.Code</code></td>
                        <td class="small">@t.Type.Name</td>
                        <td class="small text-muted">@t.DealerCount</td>
                        <td class="text-end">
                            <form asp-action="DeleteType" method="post" class="d-inline" onsubmit="return confirm('Xoá loại @t.Type.Code?');">@Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Type.Id" />
                                <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (types.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">Chưa có loại đại lý.</td></tr> }
                </tbody>
            </table>
            <form asp-action="CreateType" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-5"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã loại *" required /></div>
                <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="Tên loại *" required /></div>
                <div class="col-2"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus-lg"></i></button></div>
            </form>
        </div></div>
    </div>
</div>
