@model List<Gln>
@{ ViewData["Title"] = "Địa điểm (GLN)"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">GLN (Global Location Number) = mã địa điểm chuẩn GS1 nơi diễn ra sự kiện truy xuất.</p>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>GLN</th><th>Tên</th><th>Loại</th><th>Địa chỉ</th></tr></thead>
            <tbody>
            @foreach (var g in Model)
            {
                <tr><td class="small"><code>@g.Code</code></td><td class="fw-semibold"><i class="bi @Ui.GlnIcon(g.Type) me-1"></i>@g.Name</td>
                    <td class="small">@Ui.GlnType(g.Type)</td><td class="small text-muted">@g.Address</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có địa điểm.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm địa điểm</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên địa điểm *" required /></div>
            <div class="mb-2"><input name="code" class="form-control" placeholder="GLN 13 số (tự sinh)" /></div>
            <div class="mb-2"><select name="type" class="form-select">
                @foreach (GlnType t in Enum.GetValues(typeof(GlnType))) { <option value="@((int)t)">@Ui.GlnType(t)</option> }
            </select></div>
            <div class="mb-3"><input name="address" class="form-control" placeholder="Địa chỉ" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
