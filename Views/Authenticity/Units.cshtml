@model List<ProductUnit>
@{
    ViewData["Title"] = "Đơn vị sản phẩm (xác thực)";
    var q = (string?)ViewBag.Q;
    var products = ViewBag.Products as List<Product>;
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">Đơn vị sản phẩm (serial) — mỗi đơn vị có số serial + mã bí mật để xác thực chính hãng. Port từ Inv_InventoryBalanceSerial / Inv_InventorySecret.</p>
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-9"><input name="q" value="@q" class="form-control form-control-sm" placeholder="Tìm serial / tên sản phẩm" /></div>
            <div class="col-sm-3"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Lọc</button></div>
        </form>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Serial</th><th>Sản phẩm</th><th>Thương hiệu</th><th>Lô</th><th class="text-center">Xác thực</th><th>Bảo hành</th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold small"><code>@u.SerialNo</code></td>
                    <td>@u.ProductName</td>
                    <td>@(u.Brand?.Name ?? "—")</td>
                    <td class="small">@(u.LotCode ?? "—")</td>
                    <td class="text-center">@u.VerifyCount</td>
                    <td>
                        @if (u.Activated) { <span class="badge bg-success">Đã kích hoạt</span> }
                        else { <span class="badge bg-secondary">Chưa</span> }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn vị sản phẩm.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm đơn vị sản phẩm</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="serial" class="form-control" placeholder="Số serial *" required /></div>
            <div class="mb-2"><input name="pin" class="form-control" placeholder="Mã bí mật (PIN) *" required /></div>
            <div class="mb-2"><select name="productId" class="form-select">
                <option value="">— Sản phẩm (tuỳ chọn) —</option>
                @foreach (var p in products ?? new()) { <option value="@p.Id">@p.Name</option> }
            </select></div>
            <div class="mb-2"><input name="lotCode" class="form-control" placeholder="Mã lô thành phẩm" /></div>
            <div class="mb-2"><input name="origin" class="form-control" placeholder="Xuất xứ" /></div>
            <div class="mb-3"><input name="warrantyMonths" type="number" value="12" min="0" class="form-control" placeholder="Thời hạn bảo hành (tháng)" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
        <div class="small text-muted mt-3">Serial duy nhất theo đơn vị. Mã bí mật dùng để xác thực chính hãng và kích hoạt bảo hành.</div>
    </div></div></div>
</div>
