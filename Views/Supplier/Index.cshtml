@model List<SupplierView>
@{
    ViewData["Title"] = "Nhà cung cấp";
    var q = (string?)ViewBag.Q;
    var active = (bool?)ViewBag.Active;
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">Nhà cung cấp (master) — đối tác cung cấp nguyên vật liệu/hàng hoá. Mã nhà cung cấp duy nhất theo đơn vị. Port từ Mst_Supplier của InBrand.</p>
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6"><input name="q" value="@q" class="form-control form-control-sm" placeholder="Tìm mã / tên nhà cung cấp" /></div>
            <div class="col-sm-3"><select name="active" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="true" selected="@(active == true)">Đang hoạt động</option>
                <option value="false" selected="@(active == false)">Ngừng</option>
            </select></div>
            <div class="col-sm-3"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Lọc</button></div>
        </form>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên nhà cung cấp</th><th>Loại</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td class="fw-semibold small"><code>@v.Supplier.Code</code></td>
                    <td>@v.Supplier.Name</td>
                    <td><span class="badge bg-light text-dark border">@v.Supplier.Type</span></td>
                    <td>@if (v.Supplier.Active) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                    <td class="text-end">
                        <form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Supplier.Id" />
                            <input type="hidden" name="active" value="@((!v.Supplier.Active).ToString().ToLower())" />
                            <button class="btn btn-sm btn-outline-secondary" title="@(v.Supplier.Active ? "Ngừng" : "Kích hoạt")"><i class="bi @(v.Supplier.Active ? "bi-pause-circle" : "bi-play-circle")"></i></button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xoá nhà cung cấp @v.Supplier.Code?');">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Supplier.Id" />
                            <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có nhà cung cấp.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Thêm nhà cung cấp</h6>
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="code" class="form-control text-uppercase" placeholder="Mã nhà cung cấp (VD NCC001) *" required /></div>
                <div class="mb-2"><input name="name" class="form-control" placeholder="Tên nhà cung cấp *" required /></div>
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="active" value="true" id="supActive" checked /><label class="form-check-label" for="supActive">Đang hoạt động</label></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
            </form>
            <div class="small text-muted mt-3">Loại nhà cung cấp mặc định là <code>NORMAL</code> khi tạo (theo TConst.SupType.Normal).</div>
        </div></div>
    </div>
</div>
