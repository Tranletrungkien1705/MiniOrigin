@model List<WarrantyTypeView>
@{
    ViewData["Title"] = "Loại thời hạn bảo hành";
    var q = (string?)ViewBag.Q;
    var active = (bool?)ViewBag.Active;
    var products = (List<Product>)ViewBag.Products;
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <p class="text-muted small">Loại thời hạn bảo hành (nguồn gốc thương hiệu) — danh mục master gắn với sản phẩm. Mã loại duy nhất theo đơn vị. Port từ Mst_PartWarrantyType của InBrand.</p>
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6"><input name="q" value="@q" class="form-control form-control-sm" placeholder="Tìm mã / tên loại bảo hành" /></div>
            <div class="col-sm-3"><select name="active" class="form-select form-select-sm">
                <option value="">Tất cả trạng thái</option>
                <option value="true" selected="@(active == true)">Đang hoạt động</option>
                <option value="false" selected="@(active == false)">Ngừng</option>
            </select></div>
            <div class="col-sm-3"><button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Lọc</button></div>
        </form>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên loại bảo hành</th><th>Ghi chú</th><th class="text-center">Sản phẩm</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td class="fw-semibold small"><code>@v.Type.Code</code></td>
                    <td>@v.Type.Name</td>
                    <td class="small text-muted">@(v.Type.Remark ?? "—")</td>
                    <td class="text-center">@v.ProductCount</td>
                    <td>@if (v.Type.Active) { <span class="badge bg-success">Hoạt động</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                    <td class="text-end">
                        <form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Type.Id" />
                            <input type="hidden" name="active" value="@((!v.Type.Active).ToString().ToLower())" />
                            <button class="btn btn-sm btn-outline-secondary" title="@(v.Type.Active ? "Ngừng" : "Kích hoạt")"><i class="bi @(v.Type.Active ? "bi-pause-circle" : "bi-play-circle")"></i></button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xoá loại bảo hành @v.Type.Code?');">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Type.Id" />
                            <button class="btn btn-sm btn-outline-danger" title="Xoá"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có loại bảo hành.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Thêm loại bảo hành</h6>
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="code" class="form-control text-uppercase" placeholder="Mã loại (VD A10) *" required /></div>
                <div class="mb-2"><input name="name" class="form-control" placeholder="Tên loại bảo hành *" required /></div>
                <div class="mb-2"><input name="remark" class="form-control" placeholder="Ghi chú" /></div>
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="active" value="true" id="wtActive" checked /><label class="form-check-label" for="wtActive">Đang hoạt động</label></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
            </form>
            <div class="small text-muted mt-3">Không thể xoá loại bảo hành còn sản phẩm tham chiếu — giữ toàn vẹn dữ liệu như khoá ngoại FK_MstPartWarrantyType_MstPart.</div>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Gán loại bảo hành cho sản phẩm</h6>
            <form asp-action="Assign" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><select name="productId" class="form-select form-select-sm" required>
                    <option value="">— Chọn sản phẩm —</option>
                    @foreach (var p in products) { <option value="@p.Id">@p.Code — @p.Name</option> }
                </select></div>
                <div class="mb-3"><select name="warrantyTypeId" class="form-select form-select-sm">
                    <option value="">— Bỏ gán —</option>
                    @foreach (var v in Model.Where(x => x.Type.Active)) { <option value="@v.Type.Id">@v.Type.Code — @v.Type.Name</option> }
                </select></div>
                <button class="btn btn-outline-primary w-100"><i class="bi bi-link-45deg me-1"></i>Gán</button>
            </form>
            <div class="small text-muted mt-3">Chỉ gán được loại bảo hành đang hoạt động (theo MstPartWarrantyTypeCheckDB).</div>
        </div></div>
    </div>
</div>