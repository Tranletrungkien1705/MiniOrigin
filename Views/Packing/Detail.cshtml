@model BoxSummary
@{
    var b = Model.Box;
    ViewData["Title"] = "Hộp " + b.Code;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/Packing" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small">Số serial trong hộp</div><div class="stat-num text-success">@Model.ItemCount</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small">Thùng chứa</div><div class="stat-num">@(Model.CanCode ?? "—")</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small">Mã bí mật</div><div class="stat-num">@(b.SecretNo ?? "—")</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Serial trong hộp</h6>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Serial</th><th>Sản phẩm</th><th>Thời điểm đóng</th><th></th></tr></thead>
            <tbody>
            @foreach (var i in b.Items.OrderBy(x => x.PackedAt))
            {
                <tr>
                    <td class="small"><code>@i.SerialNo</code></td>
                    <td class="small">@(i.ProductName ?? "—")</td>
                    <td class="small text-muted">@i.PackedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        <form asp-action="Unpack" method="post" onsubmit="return confirm('Lấy serial ra khỏi hộp?');">@Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@b.Id" />
                            <input type="hidden" name="serialNo" value="@i.SerialNo" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (b.Items.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa đóng serial nào.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Đóng serial vào hộp</h6>
            <form asp-action="Pack" method="post">@Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@b.Id" />
                <div class="mb-3"><input name="serialNo" class="form-control" placeholder="Số serial *" required /></div>
                <button class="btn btn-primary w-100"><i class="bi bi-box-seam me-1"></i>Đóng vào hộp</button>
            </form>
            <div class="small text-muted mt-3">Serial phải có trong kho xác thực và chưa nằm ở hộp khác.</div>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Đóng hộp vào thùng</h6>
            <form asp-action="PackIntoCan" method="post">@Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@b.Id" />
                <div class="mb-3"><input name="boxCode" class="form-control" placeholder="Mã thùng (CanNo) *" required /></div>
                <button class="btn btn-outline-primary w-100"><i class="bi bi-boxes me-1"></i>Đóng vào thùng</button>
            </form>
            <div class="small text-muted mt-3">Hộp chỉ nằm trong 1 thùng.</div>
        </div></div>
    </div>
</div>